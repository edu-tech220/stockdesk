# syntax=docker/dockerfile:1

# ---- Etapa de build ----
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS build
WORKDIR /src

COPY StockDesk.sln ./
COPY src/StockDesk.Api/StockDesk.Api.csproj src/StockDesk.Api/
COPY src/StockDesk.Web/StockDesk.Web.csproj src/StockDesk.Web/
COPY tests/StockDesk.Api.Tests/StockDesk.Api.Tests.csproj tests/StockDesk.Api.Tests/

RUN dotnet restore src/StockDesk.Web/StockDesk.Web.csproj

COPY src/StockDesk.Web/ src/StockDesk.Web/

RUN dotnet publish src/StockDesk.Web/StockDesk.Web.csproj -c Release -o /app/publish --no-restore

# ---- Etapa final ----
FROM mcr.microsoft.com/dotnet/aspnet:8.0 AS final
WORKDIR /app

COPY --from=build /app/publish .

EXPOSE 8081
ENV ASPNETCORE_URLS=http://+:8081

ENTRYPOINT ["dotnet", "StockDesk.Web.dll"]
